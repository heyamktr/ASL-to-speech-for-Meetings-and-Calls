{
  "manifest_version": 3,
  "name": "ASL Sign Interpreter",
  "version": "0.1.0",
  "description": "Real-time ASL interpretation for Google Meet",

  "permissions": ["storage", "activeTab", "sidePanel"],
  "optional_permissions": ["camera"],

  "host_permissions": ["https://meet.google.com/*"],

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "action": {
    "default_title": "ASL Interpreter"
  },

  "side_panel": {
    "default_path": "popup/index.html"
  },

  "web_accessible_resources": [
    {
      "resources": ["mediapipe/*", "injected/mediapipe-bridge.js"],
      "matches": ["https://meet.google.com/*"]
    }
  ]
}
