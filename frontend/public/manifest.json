{
  "manifest_version": 3,
  "name": "ASL Sign Interpreter",
  "version": "0.2.0",
  "description": "Real-time ASL interpretation for Google Meet and Zoom",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "permissions": ["storage", "activeTab", "sidePanel"],
  "optional_permissions": ["camera", "microphone"],

  "host_permissions": [
    "https://meet.google.com/*",
    "https://zoom.us/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://zoom.us/*"
      ],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "action": {
    "default_title": "ASL Interpreter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "side_panel": {
    "default_path": "popup/index.html"
  },

  "web_accessible_resources": [
    {
      "resources": ["mediapipe/*", "injected/mediapipe-bridge.js"],
      "matches": [
        "https://meet.google.com/*",
        "https://zoom.us/*"
      ]
    }
  ]
}
