REDIS_URL=redis://localhost:6379
MODEL_PATH=./models/asl_model.onnx
LABEL_MAP_PATH=./models/label_map.json
LOG_LEVEL=INFO

# Capacity
MAX_CONNECTIONS=100

# Adaptive sliding-window stride (Week 5 latency lever #1)
INFERENCE_STRIDE=5
IDLE_INFERENCE_STRIDE=15

# Prediction cache (Week 5 latency lever #2)
PREDICTION_CACHE_ENABLED=1
PREDICTION_CACHE_SIZE=20
PREDICTION_CACHE_DECIMALS=2

# Text-to-speech endpoint (Week 5)
TTS_ENABLED=1
TTS_RATE=170
TTS_MAX_CHARS=300

# Uptime monitor (scripts/uptime_monitor.py)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# LLM sentence refinement — ASL gloss -> natural English (app/refine.py)
# Get a key at https://aistudio.google.com/apikey
LLM_ENABLED=1
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=256
LLM_MAX_WORDS=60
